# Copier ce fichier vers .env puis renseigner les vraies valeurs :
#   cp backend/.env.example backend/.env
# Ne JAMAIS commiter le .env rempli.

# --- Base de données ---
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# --- Authentification ---
# Générer une valeur aléatoire longue, par ex. : openssl rand -hex 32
JWT_SECRET=change-me-with-a-long-random-secret

# --- URLs ---
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# --- Emails (Resend) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# --- IA (Groq) ---
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Images (Cloudinary) ---
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_CLOUD_NAME=<cloud_name>
CLOUDINARY_API_KEY=<api_key>
CLOUDINARY_API_SECRET=<api_secret>
